---
import Icon from './Icon.astro';
---

<button class="theme-toggle" type="button" aria-live="polite" data-theme-toggle>
  <span class="theme-toggle__icon theme-toggle__icon--sun">
    <Icon name="sun" size={18} />
  </span>
  <span class="theme-toggle__icon theme-toggle__icon--moon">
    <Icon name="moon" size={18} />
  </span>
  <span class="sr-only" data-theme-label>Switch to dark theme</span>
</button>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const label = document.querySelector<HTMLElement>('[data-theme-label]');

  const syncLabel = (theme: string) => {
    if (label) {
      label.textContent = theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme';
    }
  };

  syncLabel(document.documentElement.dataset.theme ?? 'light');

  toggle?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    syncLabel(next);

    try {
      localStorage.setItem('theme', next);
    } catch {
      // Private browsing or blocked storage — the toggle still works for this visit.
    }
  });
</script>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    /* Touch devices get a full-size target; pointer devices keep the compact
       button, which reads better in the rail. */
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    background: var(--bg-elevated);
    color: var(--text-muted);
    cursor: pointer;
    transition: color var(--transition), border-color var(--transition),
      background-color var(--transition);
  }

  /* Both conditions, because a coarse pointer isn't detectable in every
     testing context but a narrow viewport always is. */
  @media (hover: none), (pointer: coarse), (max-width: 63.99rem) {
    .theme-toggle {
      width: 2.75rem;
      height: 2.75rem;
    }
  }

  .theme-toggle:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .theme-toggle__icon {
    grid-area: 1 / 1;
    display: grid;
    place-items: center;
    transition: opacity var(--transition), transform var(--transition);
  }

  :global(:root[data-theme='dark']) .theme-toggle__icon--sun,
  :global(:root:not([data-theme='dark'])) .theme-toggle__icon--moon {
    opacity: 0;
    transform: scale(0.6) rotate(-45deg);
  }

  :global(:root[data-theme='dark']) .theme-toggle__icon--moon,
  :global(:root:not([data-theme='dark'])) .theme-toggle__icon--sun {
    opacity: 1;
    transform: none;
  }
</style>
