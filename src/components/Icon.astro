---
/**
 * Inline SVG icons — replaces the render-blocking Font Awesome CDN stylesheet
 * that the old site loaded for two glyphs.
 */
interface Props {
  name: 'linkedin' | 'github' | 'mail' | 'arrow-down' | 'arrow-up' | 'external' | 'sun' | 'moon';
  size?: number;
  class?: string;
}

const { name, size = 20, class: className } = Astro.props;

const paths: Record<Props['name'], string> = {
  linkedin:
    '<path d="M4.98 3.5a2.5 2.5 0 1 1-.02 5 2.5 2.5 0 0 1 .02-5ZM3 9h4v12H3V9Zm7 0h3.8v1.65h.05a4.17 4.17 0 0 1 3.75-2.06c4 0 4.75 2.64 4.75 6.07V21h-4v-5.5c0-1.31-.03-3-1.83-3-1.83 0-2.11 1.43-2.11 2.9V21h-4V9Z"/>',
  github:
    '<path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48l-.01-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85l-.01 2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"/>',
  // fill-rule is required: without it the envelope flap doesn't cut out and the
  // icon renders as a solid block.
  mail: '<path fill-rule="evenodd" d="M2 6a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6Zm2.9 0L12 11.7 19.1 6H4.9ZM20 7.9l-7.4 5.9a1 1 0 0 1-1.2 0L4 7.9V18h16V7.9Z"/>',
  'arrow-down': '<path d="M12 4v13.2l5.6-5.6L19 13l-7 7-7-7 1.4-1.4 5.6 5.6V4h2Z"/>',
  'arrow-up': '<path d="M12 20V6.8L6.4 12.4 5 11l7-7 7 7-1.4 1.4L12 6.8V20h-2Z"/>',
  external:
    '<path d="M14 3h7v7h-2V6.4l-8.3 8.3-1.4-1.4L17.6 5H14V3ZM5 5h5v2H6v11h11v-4h2v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z"/>',
  sun: '<path d="M12 17a5 5 0 1 1 0-10 5 5 0 0 1 0 10Zm0-13V1h0v3Zm0 19v-3 3ZM4.2 5.6 2.1 3.5l1.4-1.4 2.1 2.1-1.4 1.4Zm14.2 14.2-2.1-2.1 1.4-1.4 2.1 2.1-1.4 1.4ZM1 13v-2h3v2H1Zm19 0v-2h3v2h-3ZM3.5 21.9l-1.4-1.4 2.1-2.1 1.4 1.4-2.1 2.1ZM17.7 7.7l-1.4-1.4 2.1-2.1 1.4 1.4-2.1 2.1ZM11 4V1h2v3h-2Zm0 19v-3h2v3h-2Z"/>',
  moon: '<path d="M12.3 22a10 10 0 0 1-1.4-19.9c.4-.06.8.14 1 .5.17.36.1.8-.18 1.08A7.2 7.2 0 0 0 9.6 8.7a7.2 7.2 0 0 0 9.9 6.68c.37-.15.8-.05 1.06.25.26.3.3.73.1 1.07A10 10 0 0 1 12.3 22Z"/>',
};
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
  class={className}
  set:html={paths[name]}
/>
